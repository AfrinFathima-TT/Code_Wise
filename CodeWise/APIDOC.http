###
GET http://127.0.0.1:8000/submissions/
Accept: application/json

###
POST http://127.0.0.1:8000/submissions/
Content-Type: application/json

{
    "question_id":"6",
    "answer":" 11 is a prime number",
    "owner":"Nayana"
}


###
GET http://127.0.0.1:8000/submissions/3/
Accept: application/json

###
PUT http://127.0.0.1:8000/submissions/2/
Content-Type: application/json

{
    "question_id":"6",
    "answer":"11 is a prime number",
    "owner":"Nayana"
}

###
DELETE http://127.0.0.1:8000/submissions/2/


